# StockRLTrader optional process environment variables
# The application does not load .env files automatically.
# Set these in the launching shell if needed; all have working defaults.

# Streamlit experiment artifact directory (default: outputs/experiments)
# STOCKRL_OUTPUT_DIR=outputs/experiments

# Optional proxy for online market data downloads
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
