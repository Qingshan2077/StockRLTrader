# StockTrader 环境配置示例
# 复制为 .env 文件并修改配置

# 代理设置（美股 yfinance 需要）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# 数据源: yfinance 或 akshare
# QUANT_DATA_PROVIDER=akshare

# 股票代码（A 股使用 6 位数字代码）
# QUANT_TICKER=000001

# 数据目录
# QUANT_DATA_DIR=stock_data

# 日志级别
# QUANT_LOG_LEVEL=INFO
